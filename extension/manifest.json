{
  "manifest_version": 3,
  "name": "OptiPilot — Import Optimum",
  "version": "1.7",
  "description": "Importez vos clients depuis Optimum Live en 1 clic et transférez vos devis OptiPilot vers Optimum.",
  "icons": {
    "16":  "icons/icon16.png",
    "48":  "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["activeTab", "cookies", "tabs", "alarms", "storage"],
  "host_permissions": [
    "https://optipilot-backend.onrender.com/*",
    "https://www.optipilot.fr/*",
    "https://optipilot.fr/*",
    "https://livebyoptimum.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["*://livebyoptimum.com/clients/synthese/index/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://livebyoptimum.com/*"],
      "js": ["devis-inject.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["*://optipilot.fr/*", "*://www.optipilot.fr/*"],
      "js": ["token-sync.js"],
      "run_at": "document_idle"
    }
  ]
}
